# ── Required ────────────────────────────────────────────────────────────────
# Nebius Token Factory key: https://tokenfactory.nebius.com  (API keys section)
NEBIUS_API_KEY=
# Tavily key: https://app.tavily.com
TAVILY_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# OpenAI-compatible Token Factory endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model tiers. If an ID is not in your catalog, the server picks the closest Nemotron match at startup.
# Run `python scripts/check_setup.py` (from the repo root) to see the exact IDs available to your key.
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# USD per 1M tokens, used for the live cost telemetry
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24

# Public-demo protection
RUNS_PER_IP_PER_HOUR=3
MAX_RUNS_PER_DAY=150
MAX_CONCURRENT_RUNS=4
MAX_CLAIMS=6
# Hard ceiling on total Token Factory spend (USD). Live checks pause once it's reached; the total is kept
# in data/spend.json. Each run holds back RUN_RESERVE_USD (a worst case) until its real cost is known.
MAX_SPEND_USD=1.00
RUN_RESERVE_USD=0.15

# Browser origins allowed to call the API (the Next.js dev server). Not needed in production,
# where FastAPI serves the exported site itself.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase: accounts, saved investigations, feedback, messages and the spend ledger. Without it they live in
# memory until restart. SUPABASE_URL can be the project URL (https://<ref>.supabase.co) or its Postgres connection
# string. Use the SECRET key (service_role on older projects); it never reaches the browser. Create the tables by
# running apps/api/migrations/0001_init.sql and then 0002_accounts.sql in the Supabase SQL Editor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Accounts. Sign-up codes are emailed through Resend (https://resend.com). EMAIL_FROM must use a domain you've
# verified in Resend; until then Resend only delivers to your own account email. Locally, with no key, codes are
# printed in the server log instead. ADMIN_EMAILS (comma-separated) can open /admin once they sign up.
RESEND_API_KEY=
EMAIL_FROM=ProofBeforePay <onboarding@resend.dev>
ADMIN_EMAILS=
# The site's public address, used in emails. AUTH_SECRET signs one-time codes: set a long random value in production.
PUBLIC_URL=http://localhost:3000
AUTH_SECRET=
# production: never print codes in the log, and require Resend for sign-up.
APP_ENV=development
