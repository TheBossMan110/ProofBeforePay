  "components": {
    "schemas": {
      "CodeRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "email",
          "code"
        ],
        "title": "CodeRequest"
      },
      "ContactRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "topic": {
            "type": "string",
            "enum": [
              "question",
              "feedback",
              "partnership",
              "press",
              "bug",
              "other"
            ],
            "title": "Topic",
            "default": "question"
          },
          "message": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 10,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "email",
          "name",
          "message"
        ],
        "title": "ContactRequest"
      },
      "EmailBody": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "EmailBody"
      },
      "FeedbackRequest": {
        "properties": {
          "investigation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Investigation Id"
          },
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
